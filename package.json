{
  "name": "dsh-bg-switch",
  "version": "0.4.2",
  "private": true,
  "type": "module",
  "description": "DSH plugin: 模型对话或可视化设置面板更换 DeepSeek Harness 界面背景（纯色/渐变/壁纸图片/背景视频），本地媒体上传伺服、客户端即时生效、表面文字自适应并持久化到 settings。",
  "exports": {
    "./client": "./lib/client.js",
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-theme"
      ],
      "immediately": true
    }
  },
  "dependencies": {
    "@deepseek-ai/dsh-home-paths": "0.1.2-rc.1",
    "@deepseek-ai/schemastery": "3.18.2",
    "@deepseek-ai/dsh-tools": "0.1.2-rc.1"
  },
  "scripts": {
    "build:client": "tsdown"
  },
  "devDependencies": {
    "tsdown": "0.22.2"
  }
}
